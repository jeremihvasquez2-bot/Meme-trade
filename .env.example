# Copy to .env and fill in via `node setup-from-phone.js` or `node set-key.js NAME value`.
# Never paste real keys into chat with an AI.

MODE=paper
BANKROLL_USD=50

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SOLANA_TRACKER_API_KEY=

# Optional
HELIUS_API_KEY=
ANTHROPIC_API_KEY=
WALLET_PRIVATE_KEY=

# Optional overrides (all have sane defaults in src/config.js)
BRAIN_DIR=
RPC_URL=
DELETE_ON_KILL=false
